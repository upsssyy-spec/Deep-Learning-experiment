# --------------------------
# 系统自动生成的垃圾文件
# --------------------------
.DS_Store          # Mac系统隐藏文件
Thumbs.db          # Windows图片缓存
desktop.ini        # Windows文件夹配置

# --------------------------
# 编译/运行产生的临时文件（C/C++/Java等）
# --------------------------
*.exe              # 可执行程序
*.out              # Linux编译产物
*.obj              # 目标文件
*.o                # 编译中间文件
*.dll              # 动态库
*.lib              # 静态库
*.class            # Java编译产物
*.log              # 日志文件
*.tmp              # 临时文件
*.bak              # 备份文件

# --------------------------
# Python 相关
# --------------------------
__pycache__/       # Python缓存文件夹
*.pyc              # Python编译字节码
*.pyo
.pytest_cache/
venv/              # 虚拟环境

# --------------------------
# IDE/编辑器配置文件（每个人的配置不一样，不需要提交）
# --------------------------
.idea/             # JetBrains全家桶（IDEA/CLion/PyCharm）
.vscode/           # VSCode配置
*.swp              # Vim临时文件
*~                 # 编辑器备份文件
.Dev-Cpp/          # Dev-C++配置

# --------------------------
# 其他不需要提交的
# --------------------------
*.zip
*.rar
*.7z
node_modules/      # 前端项目依赖（如果做前端的话）